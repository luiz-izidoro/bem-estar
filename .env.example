# Runtime — local development defaults.
# For production, use scripts/generate_production_config.py and a real HTTPS origin.
BEMESTAR_ENV=development
# IANA timezone used for local-day aggregation.
BEMESTAR_TIMEZONE=America/Sao_Paulo
BEMESTAR_PUBLIC_BASE_URL=http://localhost:8787
BEMESTAR_DATABASE_URL=sqlite:///./var/bemestar.db
BEMESTAR_RAW_DIR=./var/raw
BEMESTAR_LOG_LEVEL=INFO
BEMESTAR_TRUSTED_HOSTS=localhost,127.0.0.1
BEMESTAR_CORS_ORIGINS=http://localhost:5173
BEMESTAR_MAX_WEBHOOK_BYTES=26214400
BEMESTAR_RAW_RETENTION_DAYS=180
BEMESTAR_MIN_FREE_DISK_BYTES=1073741824

# Secrets: generate with scripts/generate_secrets.py
BEMESTAR_WEBHOOK_TOKEN=CHANGE_ME
BEMESTAR_MCP_TOKEN=CHANGE_ME
BEMESTAR_SESSION_SECRET=CHANGE_ME
BEMESTAR_DASHBOARD_USERNAME=admin
BEMESTAR_DASHBOARD_PASSWORD_HASH=CHANGE_ME

# Optional OpenAI-compatible LLM adapter. Leave blank for deterministic insights.
BEMESTAR_LLM_BASE_URL=
BEMESTAR_LLM_API_KEY=
BEMESTAR_LLM_MODEL=
BEMESTAR_LLM_TIMEOUT_SECONDS=30

# Optional generic outgoing notification webhook
BEMESTAR_NOTIFICATION_WEBHOOK_URL=
BEMESTAR_NOTIFICATION_WEBHOOK_TOKEN=

# Worker
BEMESTAR_WORKER_POLL_SECONDS=3
BEMESTAR_RECOMPUTE_LOOKBACK_DAYS=90

# Session / abuse controls
BEMESTAR_SESSION_TTL_SECONDS=43200
BEMESTAR_LOGIN_RATE_LIMIT=5
BEMESTAR_LOGIN_RATE_WINDOW_SECONDS=60
BEMESTAR_API_RATE_LIMIT=180
BEMESTAR_API_RATE_WINDOW_SECONDS=60
BEMESTAR_WEBHOOK_RATE_LIMIT=180
BEMESTAR_WEBHOOK_RATE_WINDOW_SECONDS=60
BEMESTAR_RATE_LIMITER_MAX_KEYS=10000
BEMESTAR_WORKER_LEASE_SECONDS=900
