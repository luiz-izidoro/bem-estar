[Unit]
Description=Bem Estar RAW retention maintenance
After=bem-estar-worker.service

[Service]
Type=oneshot
User=bem-estar
Group=bem-estar
WorkingDirectory=/opt/bem-estar/current
EnvironmentFile=/etc/bem-estar/bem-estar.env
ExecStart=/opt/bem-estar/current/.venv/bin/python /opt/bem-estar/current/scripts/maintenance.py --prune-raw
Nice=15
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bem-estar
MemoryMax=256M
TasksMax=128
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
