[Unit]
Description=Bem Estar REST/API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bem-estar
Group=bem-estar
WorkingDirectory=/opt/bem-estar/current
EnvironmentFile=/etc/bem-estar/bem-estar.env
ExecStart=/opt/bem-estar/current/.venv/bin/uvicorn bemestar.interfaces.api.app:create_app --factory --host 127.0.0.1 --port 8787 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0027
MemoryMax=512M
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bem-estar
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
